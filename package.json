{
  "name": "video-workbench",
  "version": "0.1.0",
  "description": "Programmatic Film Studio combining LoomCare architecture and huashu-motion interface",
  "private": true,
  "type": "module",
  "bin": {
    "vw": "./bin/vw.ts",
    "om": "./bin/vw.ts"
  },
  "scripts": {
    "vw": "tsx bin/vw.ts",
    "om": "tsx bin/vw.ts",
    "test": "node --test --import tsx src/shared/*.test.ts",
    "typecheck": "tsc --noEmit",
    "studio": "tsx bin/vw.ts studio",
    "check": "tsx bin/vw.ts check",
    "render": "tsx bin/vw.ts render"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@remotion/bundler": "4.0.538",
    "@remotion/media-parser": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "katex": "0.19.0",
    "p5": "2.3.3",
    "p5.brush": "2.2.3",
    "postprocessing": "^6.39.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "4.6.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.538",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.1",
    "remotion": "^4.0.538",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
